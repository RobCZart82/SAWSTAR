target_compile_definitions(sawstar_foundation PUBLIC SAWSTAR_PREMIUM_PREVIEW=1)
if(SAWSTAR_PREMIUM_NATIVE_CANDIDATE)
  target_compile_definitions(sawstar_foundation PUBLIC SAWSTAR_PREMIUM_NATIVE_CANDIDATE=1)
endif()
add_executable(sawstar_premium_preview_smoke tests/premium_preview.cpp)
if(SAWSTAR_PREMIUM_NATIVE_CANDIDATE)
  target_link_libraries(sawstar_premium_preview_smoke PRIVATE sawstar_premium_native_candidate_engine)
else()
  target_link_libraries(sawstar_premium_preview_smoke PRIVATE sawstar_premium_preview_engine)
endif()
add_library(sawstar_premium_preview_reference STATIC EXCLUDE_FROM_ALL "${_preview_engine}/UncalibratedPreviewSynth.cpp" "${_preview_engine}/MeteredPreviewSynth.cpp")
target_link_libraries(sawstar_premium_preview_reference PUBLIC sawstar_premium_preview_engine)
add_executable(sawstar_premium_preview_levels EXCLUDE_FROM_ALL tests/premium_preview_levels.cpp)
