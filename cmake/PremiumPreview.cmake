# Opt-in listening build. Production engine sources and identity stay unchanged.
set(_preview_engine "${CMAKE_CURRENT_BINARY_DIR}/premium_preview_engine")
file(MAKE_DIRECTORY "${_preview_engine}")
set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS
  "${PROJECT_SOURCE_DIR}/src/engine/Synth.h"
  "${PROJECT_SOURCE_DIR}/src/engine/Synth.cpp")
foreach(_part IN ITEMS h cpp)
  file(READ "${PROJECT_SOURCE_DIR}/src/engine/Synth.${_part}" _preview)
  if(NOT _preview MATCHES "namespace sawstar [{]")
    message(FATAL_ERROR "Preview cannot find Synth namespace")
  endif()
  string(REPLACE "namespace sawstar {" "namespace sawstar::premium_preview_engine {" _preview "${_preview}")
  if(_part STREQUAL "h")
    if(NOT _preview MATCHES "LowPass filter;")
      message(FATAL_ERROR "Preview cannot find per-voice filter")
    endif()
    string(REPLACE "#include \"dsp/LowPass.h\"" "#include \"EnginePremiumFilter.h\"" _preview "${_preview}")
    string(REPLACE "LowPass filter;" "experimental::RateScaledLookupEnginePremiumFilter filter;" _preview "${_preview}")
  else()
    string(REPLACE "#include \"engine/Synth.h\"" "#include \"PremiumPreviewSynth.h\"" _preview "${_preview}")
  endif()
  # Preserve the uncalibrated listening engine as an independent test reference.
  string(REPLACE "premium_preview_engine" "premium_preview_reference" _reference "${_preview}")
  string(REPLACE "PremiumPreviewSynth.h" "UncalibratedPreviewSynth.h" _reference "${_reference}")
  file(WRITE "${_preview_engine}/UncalibratedPreviewSynth.${_part}" "${_reference}")
  if(_part STREQUAL "h")
    string(FIND "${_preview}" "StereoSample preFX_{};" _level_member)
    if(_level_member EQUAL -1)
      message(FATAL_ERROR "Preview cannot add output calibration state")
    endif()
    string(REPLACE "#include \"EnginePremiumFilter.h\"" "#include \"EnginePremiumFilter.h\"\n#include \"plugin/PremiumPreviewLevel.h\"" _preview "${_preview}")
    string(REPLACE "StereoSample preFX_{};" "StereoSample preFX_{};\n  PremiumPreviewLevel previewLevel_;" _preview "${_preview}")
  else()
    foreach(_anchor IN ITEMS "protection_=1; width_.Init(sr);" "levels_=targetLevels_;outputGain_=" "const float scale=outputGain_/16.f;")
      string(FIND "${_preview}" "${_anchor}" _found)
      if(_found EQUAL -1)
        message(FATAL_ERROR "Preview output calibration anchor missing: ${_anchor}")
      endif()
    endforeach()
    string(REPLACE "protection_=1; width_.Init(sr);" "protection_=1; width_.Init(sr); previewLevel_.Reset(sr);" _preview "${_preview}")
    string(REPLACE "levels_=targetLevels_;outputGain_=" "levels_=targetLevels_;previewLevel_.Snap(filterMix_);outputGain_=" _preview "${_preview}")
    string(REPLACE "const float scale=outputGain_/16.f;" "const float scale=outputGain_/16.f*previewLevel_.Process(filterMix_);" _preview "${_preview}")
  endif()
  file(WRITE "${_preview_engine}/PremiumPreviewSynth.${_part}" "${_preview}")
  # Candidate qualification uses the actual calibrated Preview as reference.
  # Only the explicit, separate Candidate identity may link this engine to VST3.
  string(REPLACE "premium_preview_engine" "premium_native_candidate_engine" _candidate "${_preview}")
  string(REPLACE "PremiumPreviewSynth.h" "PremiumNativeCandidateSynth.h" _candidate "${_candidate}")
  if(_part STREQUAL "h")
    string(FIND "${_candidate}" "SevenSaw osc, osc2;" _osc_member)
    if(_osc_member EQUAL -1)
      message(FATAL_ERROR "Native candidate cannot locate the two oscillator banks")
    endif()
    string(REPLACE "#include \"dsp/SevenSaw.h\"" "#include \"dsp/SevenSaw.h\"\n#include \"SawDispatchSevenSaw.h\"" _candidate "${_candidate}")
    string(REPLACE "SevenSaw osc, osc2;" "experimental_oscillator::SawDispatchSevenSaw osc, osc2;" _candidate "${_candidate}")
  endif()
  file(WRITE "${_preview_engine}/PremiumNativeCandidateSynth.${_part}" "${_candidate}")
  # Measurement-only copy observes the pre-guard peak. Never linked to the VST3.
  string(REPLACE "premium_preview_engine" "premium_preview_meter" _meter "${_preview}")
  string(REPLACE "PremiumPreviewSynth.h" "MeteredPreviewSynth.h" _meter "${_meter}")
  if(_part STREQUAL "cpp")
    foreach(_anchor IN ITEMS "const float peak=std::max(std::abs(sum.left),std::abs(sum.right));" "const float required=peak>0.98f ? 0.98f/peak : 1.f;" "std::clamp(sum.left*protection_, -1.f, 1.f)" "std::clamp(sum.right*protection_, -1.f, 1.f)")
      string(FIND "${_meter}" "${_anchor}" _found)
      if(_found EQUAL -1)
        message(FATAL_ERROR "Preview measurement safety-guard anchor missing: ${_anchor}")
      endif()
    endforeach()
    string(REPLACE "const float peak=std::max(std::abs(sum.left),std::abs(sum.right));" "// Meter bypasses the safety guard to expose actual factory headroom." _meter "${_meter}")
    string(REPLACE "const float required=peak>0.98f ? 0.98f/peak : 1.f;" "const float required=1.f; // Test meter only: do not hide factory peaks." _meter "${_meter}")
    string(REPLACE "std::clamp(sum.left*protection_, -1.f, 1.f)" "sum.left" _meter "${_meter}")
    string(REPLACE "std::clamp(sum.right*protection_, -1.f, 1.f)" "sum.right" _meter "${_meter}")
  endif()
  file(WRITE "${_preview_engine}/MeteredPreviewSynth.${_part}" "${_meter}")
endforeach()
add_library(sawstar_premium_preview_engine STATIC "${_preview_engine}/PremiumPreviewSynth.cpp")
set_target_properties(sawstar_premium_preview_engine PROPERTIES POSITION_INDEPENDENT_CODE ON)
target_include_directories(sawstar_premium_preview_engine PUBLIC
  "${_preview_engine}" "${PROJECT_SOURCE_DIR}/experiments/premium_filter")
target_link_libraries(sawstar_premium_preview_engine PUBLIC sawstar_engine)
add_library(sawstar_premium_native_candidate_engine STATIC EXCLUDE_FROM_ALL
  "${_preview_engine}/PremiumNativeCandidateSynth.cpp"
  "${PROJECT_SOURCE_DIR}/experiments/oscillator/SawDispatchSevenSaw.cpp")
set_target_properties(sawstar_premium_native_candidate_engine PROPERTIES POSITION_INDEPENDENT_CODE ON)
target_include_directories(sawstar_premium_native_candidate_engine PUBLIC
  "${PROJECT_SOURCE_DIR}/experiments/oscillator")
target_link_libraries(sawstar_premium_native_candidate_engine PUBLIC sawstar_premium_preview_engine)
add_executable(sawstar_premium_native_pair tests/oscillator_dispatch_engine.cpp)
if(NOT BUILD_TESTING)
  set_target_properties(sawstar_premium_native_pair PROPERTIES EXCLUDE_FROM_ALL TRUE)
endif()
